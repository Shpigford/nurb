# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# three.js ships its own build/ directory and the pattern above swallows it. Without
# this the viewer's importmap points at a file that is not in the repo, which fails as
# a blank canvas rather than as an error.
!src/nurb/vendor/**/build/

# Virtual environments
.venv

# Per-worktree dev server state written by the SessionStart hook
.DS_Store

# Scratch project the MCP server tests build parts in
tests/_scratch_mcp/

/.dev/

# Per-project plugin enable/disable state written by `nurb plugin` and the
# desktop Settings panel; machine state, not source.
/.nurb/
tmp/
*.pfx
*.p12

# Conductor's local, per-checkout settings (not meant to be shared/committed)
.conductor/

