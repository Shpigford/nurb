{
  "name": "@nurb/ui",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./tokens.css",
    "./fonts/*": "./fonts/*",
    "./brand/*": "./brand/*"
  },
  "files": [
    "dist",
    "tokens.css",
    "fonts",
    "brand"
  ],
  "scripts": {
    "build": "vite build",
    "fonts:fetch": "sh scripts/fetch-satoshi.sh",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "gallery": "vite --config gallery/vite.config.ts",
    "gallery:build": "vite build --config gallery/vite.config.ts",
    "gallery:shots": "node gallery/shots.mjs",
    "site:hero": "node gallery/shots.mjs --site",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "three": "^0.185"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "cuelume": "^0.2.2",
    "motion": "^13.4.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.13",
    "three": "^0.185.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4"
  }
}
