{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nurb",
  "version": "1.4.0",
  "identifier": "dev.nurb.desktop",
  "build": {
    "beforeDevCommand": "npm run stage && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run stage && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "nurb",
        "titleBarStyle": "Overlay",
        "theme": "Light",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 33,
          "y": 44
        },
        "backgroundColor": "#e5f0fb",
        "width": 1440,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*",
        "img-src": "'self' data: blob: http://127.0.0.1:*",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:"
      },
      "devCsp": {
        "default-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*",
        "img-src": "'self' data: blob: http://127.0.0.1:*",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQyOTYyNkI5RTg3NkFFRDQKUldUVXJuYm91U2FXUWdNWGQvT1VwY2FQb3lhclFzWDZTRzhRa3k3NXRJaThJbVEzbWNmOVowbEQK",
      "endpoints": [
        "https://github.com/Shpigford/nurb/releases/download/desktop-latest/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/uv"
    ],
    "resources": [
      "resources/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
