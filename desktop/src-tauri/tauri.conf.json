{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nurb",
  "version": "0.24.0",
  "identifier": "dev.alot1z.nurb.windows",
  "build": {
    "beforeDevCommand": "npm run stage && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run stage && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "nurb",
        "backgroundColor": "#16181d",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "connect-src": "ipc: http://ipc.localhost",
        "frame-src": "'self' http://127.0.0.1:* http://localhost:*"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE4QkU4NTZDMkVDNzU1NjUKUldSbFZjY3ViSVcrR0k3VkpaeURicXZZQmE3QTRsUmlrNnZGRlEweXZaTmtFMXREYy9mK3pPbmEK",
      "endpoints": [
        "https://github.com/Alot1z/nurb-windows/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/uv"
    ],
    "resources": [
      "resources/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": true,
        "languages": [
          "English",
          "Danish"
        ]
      }
    }
  }
}
